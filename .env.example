# GPT-5 API Configuration
# Copy this file to .env and fill in your values

# Required: Your GPT-5 API key
GPT5_API_KEY=your-api-key-here

# Optional: API endpoint (defaults to OpenAI)
# For custom endpoints, use your provider's URL
GPT5_API_URL=https://api.openai.com/v1

# Examples for different providers:
# GPT5_API_URL=https://api.anthropic.com/v1
# GPT5_API_URL=https://your-custom-endpoint.com/v1
# GPT5_API_URL=https://api.together.xyz/v1
